{
  "name": "@hizollo/hzscript",
  "version": "1.6.0",
  "description": "An official implementation of HiZollo Script, written in typescript.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "type": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "node test",
    "build": "tsdown"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HiZollo/HiZollo-Script-Compiler.git"
  },
  "keywords": [
    "HiZollo",
    "Script",
    "Compiler"
  ],
  "author": "HiZollo Dev Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/uglify-js": "^3.17.5",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "uglify-js": "^3.19.3"
  }
}
